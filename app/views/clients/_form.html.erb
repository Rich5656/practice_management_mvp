<%= form_with model: client do |form| %>
  <% if client.errors.any? %>
    <div>
      <h2><%= pluralize(client.errors.count, "error") %> prevented this client from being saved:</h2>

      <ul>
        <% client.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.label :company_name %>
    <%= form.text_field :company_name %>
  </div>

  <div>
    <%= form.label :email %>
    <%= form.email_field :email %>
  </div>

  <div>
    <%= form.label :phone %>
    <%= form.telephone_field :phone %>
  </div>

  <div>
    <%= form.label :status %>
    <%= form.select :status, ["active", "inactive", "prospect"] %>
  </div>

  <%= form.submit %>
<% end %>