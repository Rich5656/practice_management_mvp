<div>
  <h1><%= @client.name %></h1>

  <% if @client.company_name.present? %>
    <p><strong>Company:</strong> <%= @client.company_name %></p>
  <% end %>

  <% if @client.email.present? %>
    <p><strong>Email:</strong> <%= @client.email %></p>
  <% end %>

  <% if @client.phone.present? %>
    <p><strong>Phone:</strong> <%= @client.phone %></p>
  <% end %>

  <p><strong>Status:</strong> <%= @client.status %></p>

  <%= link_to "Edit", edit_client_path(@client) %>

  <%= button_to "Delete",
      client_path(@client),
      method: :delete,
      data: { turbo_confirm: "Are you sure?" } %>

  <%= link_to "Back to clients", clients_path %>

  <hr>

  <section>
    <h2>Notes</h2>

    <%= form_with model: [@client, Note.new] do |form| %>
      <div>
        <%= form.label :content, "Add a note" %>
        <%= form.text_area :content %>
      </div>

      <%= form.submit "Add Note" %>
    <% end %>

    <% if @recent_notes.any? %>
      <% @recent_notes.each do |note| %>
        <article>
          <p><%= note.content %></p>
          <small><%= note.created_at.strftime("%B %-d, %Y") %></small>
        </article>
      <% end %>

      <%= link_to "View all notes", client_notes_path(@client) %>
    <% else %>
      <p>No notes yet.</p>
    <% end %>
  </section>
</div>